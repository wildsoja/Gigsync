# Copy to .env (never commit it) or set these in your host's dashboard.

# Required
ADMIN_PASSWORD=choose-a-long-password
BASE_URL=https://wildnation.ca            # your public URL, used in ticket links/QR codes

# Payments (leave empty = TEST MODE: tickets issue without payment)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...           # from Stripe > Developers > Webhooks, endpoint: BASE_URL/api/stripe/webhook

# Email tickets + notifications (any SMTP: Gmail app password, Resend, Brevo, SendGrid...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=wildnationgta@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Wild Nation <wildnationgta@gmail.com>"
OWNER_EMAIL=wildnationgta@gmail.com       # where new sales, DJ bookings and messages are sent

# Optional
BUSINESS_ADDRESS="123 Example St, Hamilton, ON"  # shown in update email footers (CASL)
CURRENCY=CAD
TIMEZONE=America/Toronto
DATA_DIR=/data                            # database + uploaded flyers; must be a persistent disk in production
# TICKET_SECRET=                          # auto-generated into DATA_DIR if unset; keep it stable or old QR codes stop working
